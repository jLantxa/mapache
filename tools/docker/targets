# Single source of truth for all build targets.
# Format: <triple> <release-name> <rustflags> <feat-args> <tool>
#
# <tool> is passed to build-target.sh: build | zigbuild | xwin
#
# Used by: build.py, build-target.sh, Dockerfile (rustup target add),
# and mirrored by .github/workflows/build.yaml.

x86_64-unknown-linux-musl        linux_amd64       "-C target-feature=+crt-static" ""                     build
aarch64-unknown-linux-musl       linux_arm64       "-C target-feature=+crt-static" ""                     zigbuild
armv7-unknown-linux-musleabihf   linux_armv7       "-C target-feature=+crt-static" ""                     zigbuild
aarch64-linux-android            android_arm64     "" "--no-default-features"                            build
x86_64-pc-windows-msvc           windows_amd64     "-C target-feature=+crt-static" ""                     xwin
x86_64-apple-darwin              darwin_amd64      "" ""                                                 zigbuild
aarch64-apple-darwin             darwin_arm64      "" ""                                                 zigbuild
