# Single source of truth for all build targets.
# Format: <triple> <release-name> <rustflags> <feat-args>
#
# Used by: build-target.sh, pack.sh, Dockerfile (rustup target add)

x86_64-unknown-linux-musl        linux_amd64       "-C target-feature=+crt-static" ""
aarch64-unknown-linux-musl       linux_arm64       "-C target-feature=+crt-static" ""
armv7-unknown-linux-musleabihf   linux_armv7       "-C target-feature=+crt-static" ""
aarch64-linux-android            android_arm64     "" "--no-default-features"
x86_64-pc-windows-msvc           windows_amd64     "-C target-feature=+crt-static" ""
x86_64-apple-darwin              darwin_amd64      "" ""
aarch64-apple-darwin             darwin_arm64      "" ""
